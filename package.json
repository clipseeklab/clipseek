{
  "name": "clipstudio-open-source",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 14210 --strictPort",
    "build": "tsc && vite build",
    "test": "npm run test:typecheck && npm run test:frontend",
    "test:typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test:unit": "vitest run tests/frontend/unit",
    "test:components": "vitest run tests/frontend/components",
    "test:integration": "vitest run tests/frontend/integration",
    "test:contract": "vitest run tests/frontend/contract",
    "test:frontend": "vitest run",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "node scripts/quality/check.mjs lint",
    "format:check": "node scripts/quality/check.mjs format",
    "check:architecture": "node scripts/quality/check.mjs architecture",
    "test:quality": "node --test tests/quality/*.test.mjs",
    "quality:check": "npm run test:quality && node scripts/quality/check.mjs check",
    "quality:strict": "node scripts/quality/check.mjs check --strict",
    "quality:rust": "node scripts/quality/check.mjs rust",
    "quality": "npm run quality:check && npm run test:typecheck && npm run test:frontend && npm run build && npm run quality:rust",
    "runtime:prepare": "node scripts/prepare-runtime.mjs",
    "runtime:build": "node scripts/build-runtime.mjs",
    "desktop": "npm run runtime:prepare && tauri dev",
    "desktop:build": "npm run runtime:prepare && tauri build",
    "test:e2e": "node scripts/e2e/run.mjs",
    "test:e2e:models": "node scripts/e2e/run.mjs models"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.102.5",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^26.4.0",
    "lucide-react": "^1.34.0",
    "radix-ui": "^1.6.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.12",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "serialize-javascript": "7.0.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^5.0.1",
    "@wdio/cli": "9.32.0",
    "@wdio/globals": "9.31.3",
    "@wdio/local-runner": "9.32.0",
    "@wdio/mocha-framework": "9.32.0",
    "@wdio/spec-reporter": "9.32.0",
    "@wdio/tauri-plugin": "1.4.0",
    "@wdio/tauri-service": "1.4.0",
    "autoprefixer": "^10.5.5",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "^29.1.1",
    "onnxruntime-node": "1.30.0",
    "postcss": "^8.5.28",
    "prettier": "3.9.10",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.8.3",
    "typescript-eslint": "8.71.2",
    "vite": "^7.0.4",
    "vitest": "^5.0.1",
    "webdriverio": "9.32.0",
    "yaml": "2.9.0"
  },
  "license": "Apache-2.0"
}
